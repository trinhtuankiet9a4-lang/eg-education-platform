# ============================================================
# EG Education Platform - Production Environment Configuration
# Copy this file to .env and update secrets before deploying.
# ============================================================

# Unified Production Server (Express API + Static Frontend dist/)
PORT=5000
NODE_ENV=production

# Authentication Security (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=eg-edu-production-secret-key-change-me

# CORS Allowed Origins ('*' for open access, or comma-separated URLs e.g. https://edu.example.com,http://localhost:5173)
ALLOWED_ORIGINS=*

# Backend-Only Multi-Provider Free AI Configuration
# Leave API keys blank to run instantly on built-in Deep SQLite RAG + Academic NLP (<100ms, 100% offline/free).
# Optional: configure free server-side keys here so the backend upgrades automatically with zero UI setup:
AI_PROVIDER=auto
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
